<mjml>
  <mj-head>
    <mj-title>Support request received — RCapsule</mj-title>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-body background-color="#FAFAFA" />
      <mj-section background-color="#FFFFFF" padding="0" />
      <mj-text color="#525252" font-size="15px" line-height="1.7" padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#FAFAFA">

    <mj-section background-color="#FAFAFA" padding="32px 0 0">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" border="1px solid #E5E5E5" padding="0">
      <mj-column padding="0">

        <!-- Header with Support label -->
        <mj-text padding="28px 40px" border-bottom="1px solid #E5E5E5">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td><span style="font-size:18px;font-weight:700;letter-spacing:0.08em;color:#171717;text-transform:uppercase;">RCAPSULE</span></td>
              <td align="right"><span style="font-size:11px;font-weight:600;letter-spacing:0.10em;text-transform:uppercase;color:#A3A3A3;">Support</span></td>
            </tr>
          </table>
        </mj-text>

        <!-- Body -->
        <mj-text padding="40px 40px 0">
          <p style="margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#A3A3A3;">Request Received</p>
          <h1 style="margin:0 0 20px;font-size:28px;font-weight:300;color:#171717;line-height:1.25;letter-spacing:-0.01em;">We've got<br/>your message</h1>
          <p style="margin:0 0 24px;width:32px;height:1px;background-color:#171717;font-size:0;line-height:0;"> </p>
          <p style="margin:0 0 16px;">Hi {DATA_VARIABLE:firstName},</p>
          <p style="margin:0 0 32px;">Thanks for reaching out. We've received your support request and our team will get back to you as soon as possible — typically within 1 business day.</p>
        </mj-text>

        <!-- Ticket summary table -->
        <mj-text padding="0 40px 0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E5E5E5;">
            <tr>
              <td colspan="2" style="padding:14px 20px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#A3A3A3;border-bottom:1px solid #E5E5E5;">Your Request</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#A3A3A3;width:100px;border-bottom:1px solid #F5F5F5;vertical-align:top;">Ticket</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;border-bottom:1px solid #F5F5F5;">{DATA_VARIABLE:ticketId}</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#A3A3A3;width:100px;border-bottom:1px solid #F5F5F5;vertical-align:top;">Subject</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;border-bottom:1px solid #F5F5F5;">{DATA_VARIABLE:subject}</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:12px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#A3A3A3;width:100px;vertical-align:top;">Message</td>
              <td style="padding:14px 20px;font-size:13px;color:#525252;line-height:1.6;">{DATA_VARIABLE:message}</td>
            </tr>
          </table>
        </mj-text>

        <!-- Reply note -->
        <mj-text padding="16px 40px 40px">
          <div style="padding:16px;background-color:#F5F5F5;border-left:2px solid #D4D4D4;">
            <p style="margin:0;font-size:12px;color:#737373;line-height:1.6;">
              Please quote your ticket ID <strong style="color:#171717;">{DATA_VARIABLE:ticketId}</strong> when following up. You can also simply reply to this email and your response will be added to your ticket.
            </p>
          </div>
        </mj-text>

        <!-- Footer -->
        <mj-text padding="24px 40px" border-top="1px solid #E5E5E5" background-color="#FAFAFA" font-size="11px" color="#A3A3A3" line-height="1.6">
          <p style="margin:0 0 8px;letter-spacing:0.06em;text-transform:uppercase;">RCapsule · Your digital wardrobe</p>
          <p style="margin:0;">
            You received this because you submitted a support request at <a href="https://rcapsule.com" style="color:#737373;">rcapsule.com</a><br/>
<a href="https://rcapsule.com/privacy" style="color:#737373;">Privacy Policy</a>
          </p>
        </mj-text>

      </mj-column>
    </mj-section>

    <mj-section background-color="#FAFAFA" padding="0 0 32px">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
