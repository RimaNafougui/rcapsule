<mjml>
  <mj-head>
    <mj-title>Your receipt — RCapsule</mj-title>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-body background-color="#FAFAFA" />
      <mj-section background-color="#FFFFFF" padding="0" />
      <mj-text color="#525252" font-size="15px" line-height="1.7" padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#FAFAFA">

    <mj-section background-color="#FAFAFA" padding="32px 0 0">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" border="1px solid #E5E5E5" padding="0">
      <mj-column padding="0">

        <!-- Header with Receipt label -->
        <mj-text padding="28px 40px" border-bottom="1px solid #E5E5E5">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td><span style="font-size:18px;font-weight:700;letter-spacing:0.08em;color:#171717;text-transform:uppercase;">RCAPSULE</span></td>
              <td align="right"><span style="font-size:11px;font-weight:600;letter-spacing:0.10em;text-transform:uppercase;color:#A3A3A3;">Receipt</span></td>
            </tr>
          </table>
        </mj-text>

        <!-- Body -->
        <mj-text padding="40px 40px 0">
          <p style="margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#A3A3A3;">Payment Confirmed</p>
          <h1 style="margin:0 0 20px;font-size:28px;font-weight:300;color:#171717;line-height:1.25;letter-spacing:-0.01em;">Thank you for<br/>your payment</h1>
          <p style="margin:0 0 24px;width:32px;height:1px;background-color:#171717;font-size:0;line-height:0;"> </p>
          <p style="margin:0 0 32px;">Hi {DATA_VARIABLE:firstName}, here's your receipt for your most recent RCapsule payment.</p>
        </mj-text>

        <!-- Invoice table -->
        <mj-text padding="0 40px 0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E5E5E5;">
            <tr>
              <td colspan="2" style="padding:14px 20px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#A3A3A3;border-bottom:1px solid #E5E5E5;">Invoice Details</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:13px;color:#737373;border-bottom:1px solid #F5F5F5;">Plan</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;text-align:right;border-bottom:1px solid #F5F5F5;">{DATA_VARIABLE:planName}</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:13px;color:#737373;border-bottom:1px solid #F5F5F5;">Billing period</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;text-align:right;border-bottom:1px solid #F5F5F5;">{DATA_VARIABLE:billingPeriodStart} – {DATA_VARIABLE:billingPeriodEnd}</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:13px;color:#737373;border-bottom:1px solid #E5E5E5;">Invoice ID</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;text-align:right;border-bottom:1px solid #E5E5E5;">{DATA_VARIABLE:invoiceId}</td>
            </tr>
            <tr style="background-color:#171717;">
              <td style="padding:16px 20px;font-size:13px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#FFFFFF;">Total Paid</td>
              <td style="padding:16px 20px;font-size:18px;font-weight:600;color:#FFFFFF;text-align:right;">{DATA_VARIABLE:amountPaid}</td>
            </tr>
          </table>
        </mj-text>

        <!-- View invoice CTA (outlined) -->
        <mj-text padding="24px 40px 40px">
          <a href="{DATA_VARIABLE:invoiceUrl}" style="display:inline-block;padding:13px 32px;font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif;font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#171717;text-decoration:none;border:1px solid #171717;">
            View Full Invoice
          </a>
        </mj-text>

        <!-- Footer -->
        <mj-text padding="24px 40px" border-top="1px solid #E5E5E5" background-color="#FAFAFA" font-size="11px" color="#A3A3A3" line-height="1.6">
          <p style="margin:0 0 8px;letter-spacing:0.06em;text-transform:uppercase;">RCapsule · Your digital wardrobe</p>
          <p style="margin:0;">
            Questions? <a href="mailto:billing@rcapsule.com" style="color:#737373;">billing@rcapsule.com</a><br/>
<a href="https://rcapsule.com/privacy" style="color:#737373;">Privacy Policy</a>
          </p>
        </mj-text>

      </mj-column>
    </mj-section>

    <mj-section background-color="#FAFAFA" padding="0 0 32px">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
