<mjml>
  <mj-head>
    <mj-title>Verify your email — RCapsule</mj-title>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-body background-color="#FAFAFA" />
      <mj-section background-color="#FFFFFF" padding="0" />
      <mj-text color="#525252" font-size="15px" line-height="1.7" padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#FAFAFA">

    <!-- Spacer -->
    <mj-section background-color="#FAFAFA" padding="32px 0 0">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <!-- Card wrapper -->
    <mj-section background-color="#FFFFFF" border="1px solid #E5E5E5" padding="0">
      <mj-column padding="0">

        <!-- ── Header ── -->
        <mj-text padding="28px 40px" border-bottom="1px solid #E5E5E5">
          <span style="font-size:18px;font-weight:700;letter-spacing:0.08em;color:#171717;text-transform:uppercase;">RCAPSULE</span>
        </mj-text>

        <!-- ── Body ── -->
        <mj-text padding="40px 40px 0">
          <p style="margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#A3A3A3;">Email Verification</p>
          <h1 style="margin:0 0 20px;font-size:28px;font-weight:300;color:#171717;line-height:1.25;letter-spacing:-0.01em;">Confirm your<br/>email address</h1>
          <p style="margin:0 0 24px;width:32px;height:1px;background-color:#171717;font-size:0;line-height:0;"> </p>
          <p style="margin:0 0 16px;">Hi {DATA_VARIABLE:firstName},</p>
          <p style="margin:0 0 32px;">Thanks for joining RCapsule. To complete your sign-up, please verify your email address by clicking the button below.</p>
        </mj-text>

        <!-- CTA Button -->
        <mj-button
          href="{DATA_VARIABLE:confirmationUrl}"
          background-color="#171717"
          color="#FFFFFF"
          font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif"
          font-size="13px"
          font-weight="600"
          letter-spacing="0.08em"
          text-transform="uppercase"
          border-radius="0"
          padding="0 40px 0"
          inner-padding="14px 32px"
          align="left"
        >
          Verify Email Address
        </mj-button>

        <!-- Fallback URL -->
        <mj-text padding="16px 40px 0" font-size="12px" color="#A3A3A3" line-height="1.6">
          Or copy and paste this link into your browser:<br/>
          <a href="{DATA_VARIABLE:confirmationUrl}" style="color:#525252;word-break:break-all;">{DATA_VARIABLE:confirmationUrl}</a>
        </mj-text>

        <!-- Security note -->
        <mj-text padding="24px 40px 40px">
          <div style="padding:16px;background-color:#F5F5F5;border-left:2px solid #D4D4D4;">
            <p style="margin:0;font-size:12px;color:#737373;line-height:1.6;">
              This link expires in <strong style="color:#171717;">24 hours</strong>. If you did not create an account, you can safely ignore this email.
            </p>
          </div>
        </mj-text>

        <!-- ── Footer ── -->
        <mj-text padding="24px 40px" border-top="1px solid #E5E5E5" background-color="#FAFAFA" font-size="11px" color="#A3A3A3" line-height="1.6">
          <p style="margin:0 0 8px;letter-spacing:0.06em;text-transform:uppercase;">RCapsule · Your digital wardrobe</p>
          <p style="margin:0;">
            You received this because someone used your email to create an RCapsule account.<br/>
<a href="https://rcapsule.com/privacy" style="color:#737373;">Privacy Policy</a>
          </p>
        </mj-text>

      </mj-column>
    </mj-section>

    <!-- Bottom spacer -->
    <mj-section background-color="#FAFAFA" padding="0 0 32px">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
