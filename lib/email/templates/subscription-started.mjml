<mjml>
  <mj-head>
    <mj-title>Subscription confirmed — RCapsule</mj-title>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-body background-color="#FAFAFA" />
      <mj-section background-color="#FFFFFF" padding="0" />
      <mj-text color="#525252" font-size="15px" line-height="1.7" padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#FAFAFA">

    <mj-section background-color="#FAFAFA" padding="32px 0 0">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" border="1px solid #E5E5E5" padding="0">
      <mj-column padding="0">

        <!-- Header — inverted -->
        <mj-text padding="28px 40px" background-color="#171717">
          <span style="font-size:18px;font-weight:700;letter-spacing:0.08em;color:#FFFFFF;text-transform:uppercase;">RCAPSULE</span>
        </mj-text>

        <!-- Body -->
        <mj-text padding="40px 40px 0">
          <p style="margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#A3A3A3;">Subscription Active</p>
          <h1 style="margin:0 0 20px;font-size:28px;font-weight:300;color:#171717;line-height:1.25;letter-spacing:-0.01em;">You're all set.</h1>
          <p style="margin:0 0 24px;width:32px;height:1px;background-color:#171717;font-size:0;line-height:0;"> </p>
          <p style="margin:0 0 16px;">Hi {DATA_VARIABLE:firstName},</p>
          <p style="margin:0 0 32px;">Your <strong style="color:#171717;">{DATA_VARIABLE:planName}</strong> subscription is now active. You have full access to all premium features.</p>
        </mj-text>

        <!-- Plan summary table -->
        <mj-text padding="0 40px 0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E5E5E5;">
            <tr>
              <td colspan="2" style="padding:14px 20px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#A3A3A3;border-bottom:1px solid #E5E5E5;">Plan Summary</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:13px;color:#737373;border-bottom:1px solid #F5F5F5;">Plan</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;text-align:right;border-bottom:1px solid #F5F5F5;">{DATA_VARIABLE:planName}</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:13px;color:#737373;border-bottom:1px solid #F5F5F5;">Billing</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;text-align:right;text-transform:capitalize;border-bottom:1px solid #F5F5F5;">{DATA_VARIABLE:billingInterval}</td>
            </tr>
            <tr>
              <td style="padding:14px 20px;font-size:13px;color:#737373;">Next billing date</td>
              <td style="padding:14px 20px;font-size:13px;font-weight:500;color:#171717;text-align:right;">{DATA_VARIABLE:nextBillingDate}</td>
            </tr>
          </table>
        </mj-text>

        <!-- CTA -->
        <mj-button
          href="https://rcapsule.com/closet"
          background-color="#171717"
          color="#FFFFFF"
          font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif"
          font-size="13px"
          font-weight="600"
          letter-spacing="0.08em"
          text-transform="uppercase"
          border-radius="0"
          padding="24px 40px 40px"
          inner-padding="14px 32px"
          align="left"
        >
          Go to My Closet
        </mj-button>

        <!-- Footer -->
        <mj-text padding="24px 40px" border-top="1px solid #E5E5E5" background-color="#FAFAFA" font-size="11px" color="#A3A3A3" line-height="1.6">
          <p style="margin:0 0 8px;letter-spacing:0.06em;text-transform:uppercase;">RCapsule · Your digital wardrobe</p>
          <p style="margin:0;">
            Manage your subscription at <a href="https://rcapsule.com/settings" style="color:#737373;">rcapsule.com/settings</a><br/>
<a href="https://rcapsule.com/privacy" style="color:#737373;">Privacy Policy</a>
          </p>
        </mj-text>

      </mj-column>
    </mj-section>

    <mj-section background-color="#FAFAFA" padding="0 0 32px">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
