<mjml>
  <mj-head>
    <mj-title>Your trial is ending — RCapsule</mj-title>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-body background-color="#FAFAFA" />
      <mj-section background-color="#FFFFFF" padding="0" />
      <mj-text color="#525252" font-size="15px" line-height="1.7" padding="0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#FAFAFA">

    <mj-section background-color="#FAFAFA" padding="32px 0 0">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" border="1px solid #E5E5E5" padding="0">
      <mj-column padding="0">

        <!-- Header -->
        <mj-text padding="28px 40px" border-bottom="1px solid #E5E5E5">
          <span style="font-size:18px;font-weight:700;letter-spacing:0.08em;color:#171717;text-transform:uppercase;">RCAPSULE</span>
        </mj-text>

        <!-- Body -->
        <mj-text padding="40px 40px 0">
          <p style="margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:#A3A3A3;">Trial Reminder</p>
          <h1 style="margin:0 0 20px;font-size:28px;font-weight:300;color:#171717;line-height:1.25;letter-spacing:-0.01em;">Your free trial<br/>ends soon</h1>
          <p style="margin:0 0 24px;width:32px;height:1px;background-color:#171717;font-size:0;line-height:0;"> </p>
          <p style="margin:0 0 16px;">Hi {DATA_VARIABLE:firstName},</p>
          <p style="margin:0 0 24px;">Your RCapsule free trial is coming to a close. To keep uninterrupted access to AI outfit recommendations, background removal, and all premium features, upgrade before your trial ends.</p>
        </mj-text>

        <!-- Trial end date highlight -->
        <mj-text padding="0 40px 24px">
          <div style="padding:20px;background-color:#F5F5F5;border-left:2px solid #171717;">
            <p style="margin:0 0 4px;font-size:11px;font-weight:600;letter-spacing:0.10em;text-transform:uppercase;color:#A3A3A3;">Trial ends</p>
            <p style="margin:0;font-size:20px;font-weight:300;color:#171717;letter-spacing:-0.01em;">{DATA_VARIABLE:trialEndDate}</p>
          </div>
        </mj-text>

        <!-- What you keep -->
        <mj-text padding="0 40px 0">
          <p style="margin:0 0 16px;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#A3A3A3;">What you keep with Pro</p>
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr><td style="padding:10px 0;border-bottom:1px solid #F5F5F5;font-size:14px;color:#525252;"><span style="color:#171717;margin-right:10px;">✓</span> AI outfit recommendations</td></tr>
            <tr><td style="padding:10px 0;border-bottom:1px solid #F5F5F5;font-size:14px;color:#525252;"><span style="color:#171717;margin-right:10px;">✓</span> Background removal for wardrobe photos</td></tr>
            <tr><td style="padding:10px 0;border-bottom:1px solid #F5F5F5;font-size:14px;color:#525252;"><span style="color:#171717;margin-right:10px;">✓</span> Unlimited items &amp; outfits</td></tr>
            <tr><td style="padding:10px 0;font-size:14px;color:#525252;"><span style="color:#171717;margin-right:10px;">✓</span> Weather-aware outfit suggestions</td></tr>
          </table>
        </mj-text>

        <!-- CTA -->
        <mj-button
          href="{DATA_VARIABLE:upgradeUrl}"
          background-color="#171717"
          color="#FFFFFF"
          font-family="'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif"
          font-size="13px"
          font-weight="600"
          letter-spacing="0.08em"
          text-transform="uppercase"
          border-radius="0"
          padding="24px 40px 40px"
          inner-padding="14px 32px"
          align="left"
        >
          Upgrade Now
        </mj-button>

        <!-- Footer -->
        <mj-text padding="24px 40px" border-top="1px solid #E5E5E5" background-color="#FAFAFA" font-size="11px" color="#A3A3A3" line-height="1.6">
          <p style="margin:0 0 8px;letter-spacing:0.06em;text-transform:uppercase;">RCapsule · Your digital wardrobe</p>
          <p style="margin:0;">
            Questions? <a href="mailto:hello@rcapsule.com" style="color:#737373;">hello@rcapsule.com</a><br/>
<a href="https://rcapsule.com/privacy" style="color:#737373;">Privacy Policy</a>
          </p>
        </mj-text>

      </mj-column>
    </mj-section>

    <mj-section background-color="#FAFAFA" padding="0 0 32px">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

  </mj-body>
</mjml>
